<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- J Stem & Hook -->
    <path
        android:pathData="M52,32 L52,74 C52,84 38,84 38,74"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="52"
                android:startY="32"
                android:endX="38"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F5D4" /> <!-- Neon Mint/Teal -->
                <item android:offset="1.0" android:color="#10B981" /> <!-- Emerald -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- b Loop -->
    <path
        android:pathData="M52,50 C64,50 70,56 70,62 C70,68 64,74 52,74"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="52"
                android:startY="50"
                android:endX="70"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F5D4" /> <!-- Neon Mint/Teal -->
                <item android:offset="1.0" android:color="#10B981" /> <!-- Emerald -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing dot of hope (J dot) -->
    <path
        android:pathData="M52,21 L52,21.1"
        android:strokeWidth="8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="52"
                android:startY="17"
                android:endX="52"
                android:endY="25"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#00F5D4" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
